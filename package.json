{
  "name": "toneforge",
  "version": "0.1.2",
  "description": "Generate placeholder sound effects instantly so development never stalls waiting for final audio assets.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tf": "bin/dev-cli.js",
    "toneforge": "bin/dev-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:web:e2e": "npm run test:e2e:ci --prefix web",
    "verify": "npm run typecheck && npm test && npm test --prefix web && npm run test:web:e2e",
    "test:watch": "vitest",
    "start": "./bin/dev-cli.js",
    "generate": "./bin/dev-cli.js generate",
    "demo": "tsx scripts/demo/run.ts",
    "dev:web": "node scripts/dev-web.mjs",
    "postinstall": "node ./scripts/postinstall-cli-link.mjs"
  },
  "keywords": [
    "audio",
    "procedural",
    "synthesis",
    "tone.js",
    "sfx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "buffer": "^6.0.3",
    "fft.js": "^4.0.4",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yargs": "^17.7.2"
  },
  "optionalDependencies": {
    "node-web-audio-api": "^1.0.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/marked-terminal": "^6.1.1",
    "@types/yargs": "^17.0.35",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
