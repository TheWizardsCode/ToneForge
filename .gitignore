##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

### End of Worklog Specific Ignores

##################################
# Generated audio output
##################################
output/
delivery/
export/
export-weapon/
filtered-export/
gravel-steps/
creatures/
analysis/
classification/
assets/sfx/

##################################
# Exploration run data
##################################
.exploration/

##################################
# Library and demo output
##################################
.toneforge-library/
card-sfx/
game-assets/

##################################
# TUI wizard session files
##################################
.toneforge-session*.json

##################################
# Build output binaries
##################################
bin/

##################################
# Node / TypeScript
##################################
node_modules/
# Also ignore a symlink named exactly `node_modules` (no trailing slash):
# `phase_start` links the main checkout's dependency tree into each worktree,
# and a trailing-slash pattern does NOT match a symlink. Without this rule
# `git add -A` stages the symlink and pushes a self-referential link to dev,
# breaking every fresh checkout (TF-0MUUEZE48002CLBX).
node_modules
.implement_state.json
.port-skips
dist/
dist-server/
*.tsbuildinfo

##################################
# Dev server port coordination file
##################################
web/.port

##################################
# Playwright
##################################
playwright-report/
test-results/
